// Cloudflare Worker config for the portfolio chatbot. Setup steps:
// docs/cloudflare-worker-setup.md. Stays on the Workers Free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Served at https://portfolio-chat.capuajairo32.workers.dev; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "portfolio-chat",
      // From `npx wrangler d1 create portfolio-chat` (APAC).
      "database_id": "83b1da4a-0015-4afb-9afd-91da905d7b20",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated. Only these origins may call /chat.
    "ALLOWED_ORIGINS": "https://jairocapua.github.io,http://localhost:3000"
  },
  // Daily cleanup: questions older than 30 days, expired counters.
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
